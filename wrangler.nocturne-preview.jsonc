{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nhs-os-nocturne-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [],
  "keep_vars": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
