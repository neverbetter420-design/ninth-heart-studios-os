# Supabase Connect dialog -> Project URL + Publishable key
# Canonical NHS OS hostname for emailed reset links (server-side, not the Wix site)
NHS_APP_URL="https://app.ninthheartstudios.com"
NEXT_PUBLIC_SUPABASE_URL="https://rquscwgdrqkzwjukiqtk.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_7N1_IhU0_mvs6q0ppgyssA_0O6xj-L2"

# SERVER-ONLY. Never expose this in browser code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=""

# Gmail sending (Muse drafts). Google account -> 2-Step Verification ON ->
# App Password named "NHS OS". Spaces in the password are stripped by the app.
# Server-only — never commit a real value.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Muse conversational assistant: disabled until separately enabled in Workers.
# Server-only secret; never use NEXT_PUBLIC_ for an OpenAI credential.
MUSE_AI_ENABLED="false"
# Select cloudflare-free only after confirming Workers Free billing.
MUSE_AI_PROVIDER="openai"
# Absent/false fails closed. Clear BEFORE any Workers Paid upgrade.
MUSE_CF_FREE_PLAN_CONFIRMED="false"
# Separate release gate for confirmation-bound project-plan creation.
MUSE_PROJECT_GUIDE_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_MUSE_MODEL="gpt-6.1-sol"

# Development seed accounts. Replace before running `npm run seed:test-users`.
