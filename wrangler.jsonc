{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ninth-heart-studios-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "ai": { "binding": "MUSE_AI" },
  "ratelimits": [
    {
      "name": "MUSE_AI_RATE_LIMITER",
      "namespace_id": "929010",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "previews": {
    "ai": { "binding": "MUSE_AI" },
    "ratelimits": [
      {
        "name": "MUSE_AI_RATE_LIMITER",
        "namespace_id": "929011",
        "simple": { "limit": 6, "period": 60 }
      }
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
